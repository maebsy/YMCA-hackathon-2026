# 이 파일을 복사해 .env 를 만들고 값을 채우세요:  cp .env.example .env
# .env 는 커밋되지 않습니다. 이 파일에는 실제 키를 절대 쓰지 마세요.

# DB: 비워 두면 로컬 SQLite(backend/app.db)를 씁니다. 팀 공용은 Supabase 연결 문자열
#   Supabase 대시보드 > Connect > Session pooler 의 URI (비밀번호는 팀 채팅에서)
DATABASE_URL=

# LLM 서버 (개발: OpenAI·Ollama / 실서버: GPU 서버의 vLLM)
#   vLLM은 8001 포트로 띄웁니다 (백엔드 8000과 겹치지 않게). 내 PC에서는 SSH 터널로 같은 8001을 엽니다
#   Docker로 띄운 백엔드는 이 값 대신 아래 DOCKER_LLM_BASE_URL 을 씁니다
LLM_BASE_URL=http://localhost:8001/v1
#   GPU 서버 ~/.config/ymca/vllm-api-key 의 값 (scripts/llm/serve.sh 가 처음 실행될 때 만듦, 채팅으로 공유)
LLM_API_KEY=
LLM_MODEL=qwen3.8-27b

# Hugging Face (모델 다운로드용)
HF_TOKEN=

# Docker Compose (docker compose 로 띄울 때만 씀, 비워 두면 기본값)
#   8000·5432를 다른 프로그램(로컬 PostgreSQL 등)이 쓰고 있으면 바꾸세요
BACKEND_PORT=
POSTGRES_PORT=
#   컨테이너에서 부를 LLM 주소. 비워 두면 http://host.docker.internal:8001/v1 (내 PC의 8001 = vLLM SSH 터널)
DOCKER_LLM_BASE_URL=
