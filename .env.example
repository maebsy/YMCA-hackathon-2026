# 이 파일을 복사해 .env 를 만들고 값을 채우세요:  cp .env.example .env
# .env 는 커밋되지 않습니다. 이 파일에는 실제 키를 절대 쓰지 마세요.

# DB: 비워 두면 로컬 SQLite(backend/app.db)를 씁니다. 팀 공용은 Supabase 연결 문자열
#   Supabase 대시보드 > Connect > Session pooler 의 URI (비밀번호는 팀 채팅에서)
DATABASE_URL=

# LLM 서버 (개발: OpenAI·Ollama / 실서버: GPU 서버의 vLLM)
#   vLLM은 8001 포트로 띄웁니다 (백엔드 8000과 겹치지 않게). 내 PC에서는 SSH 터널로 같은 8001을 엽니다
#   Docker로 띄운 백엔드는 이 값 대신 아래 DOCKER_LLM_BASE_URL 을 씁니다
LLM_BASE_URL=http://localhost:8001/v1
#   GPU 서버 ~/.config/ymca/vllm-api-key 의 값 (scripts/llm/serve.sh 가 처음 실행될 때 만듦, 채팅으로 공유)
LLM_API_KEY=
LLM_MODEL=qwen3.8-27b
#   Red(공격자 관점 검토)의 생각 깊이: low(기본) · medium · high. 깊을수록 느립니다
LLM_RED_REASONING_EFFORT=
#   문맥 분석을 LLM으로 할지(false면 규칙 신호만, 호출 1회 절약), KEV·EPSS 위협 정보를 조회할지
LLM_ANALYZE_CONTEXT=true
LLM_THREAT_INTEL=true
#   공개 시연용 해석 대기열: 동시 실행 수(기본 6)와 대기 상한(기본 30). GPU 상황에 맞게 줄이거나 늘립니다
LLM_PREVIEW_RUNNING=
LLM_PREVIEW_CAPACITY=

# #26 opt-in: #7 스키마 + docs/migrations/026-async-llm.sql 리뷰/적용 후에만 켭니다.
# true이면 동기 /api/llm/explain 및 예제 items API 대신 인증된 비동기 API를 등록합니다.
LLM_JOBS_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# true이면 /api/scans(저장소 검사)를 Supabase 로그인 사용자만 쓸 수 있습니다. 위 SUPABASE_* 두 값이 필요합니다 (#53)
SCAN_REQUIRE_AUTH=false
# 검사할 수 있는 GitHub 소유자(쉼표 목록). 비우면 제한 없음(로컬 개발). 공개 서버는 반드시 채웁니다 (#67)
SCAN_ALLOWED_OWNERS=
# 위 제한을 받지 않는 관리자 Supabase 사용자 ID(쉼표 목록, LLM_JOBS_ENABLED=true 일 때)
SCAN_ADMIN_USER_IDS=
# 별도 worker의 lease/전체 작업 제한. 기존 LLM_TIMEOUT_S는 개별 모델 호출 제한입니다.
LLM_JOB_LEASE_S=180
LLM_JOB_TIMEOUT_S=900
LLM_JOB_POLL_S=2

# Hugging Face (모델 다운로드용)
HF_TOKEN=

# Docker Compose (docker compose 로 띄울 때만 씀, 비워 두면 기본값)
#   8000·5432를 다른 프로그램(로컬 PostgreSQL 등)이 쓰고 있으면 바꾸세요
FRONTEND_PORT=
BACKEND_PORT=
POSTGRES_PORT=
#   컨테이너에서 부를 LLM 주소. 비워 두면 http://host.docker.internal:8001/v1 (내 PC의 8001 = vLLM SSH 터널)
DOCKER_LLM_BASE_URL=
