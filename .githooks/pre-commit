#!/usr/bin/env bash
# 커밋 직전에 비밀정보 파일, API 키, 대용량 파일이 섞였는지 검사합니다.
set -uo pipefail

MAX_KB=5120   # 5MB 넘는 데이터·모델 파일은 서버에 둡니다
SECRET_RE='(sk-[A-Za-z0-9_-]{20,}|hf_[A-Za-z0-9]{30,}|gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'
fail=0

while IFS= read -r -d '' f; do
  case "$f" in
    *.env.example) ;;
    .env | */.env | .env.* | */.env.* | *.pem | *.key | *.p12 | *.pfx | *id_rsa* | *id_ed25519*)
      echo "❌ 비밀정보 파일은 커밋할 수 없습니다: $f" >&2
      fail=1
      continue
      ;;
  esac

  size_kb=$(( $(git cat-file -s ":$f") / 1024 ))
  if (( size_kb > MAX_KB )); then
    echo "❌ ${size_kb}KB 파일은 커밋할 수 없습니다 (최대 ${MAX_KB}KB): $f" >&2
    echo "   데이터·모델 파일은 서버나 Hugging Face에 두고 경로만 기록하세요." >&2
    fail=1
    continue
  fi

  if git diff --cached -U0 -- "$f" | grep '^+' | grep -v '^+++' | grep -Eq "$SECRET_RE"; then
    echo "❌ API 키·토큰으로 보이는 값이 있습니다: $f" >&2
    echo "   키는 .env 에 두고 코드에서는 os.environ 으로 읽으세요." >&2
    fail=1
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if (( fail )); then
  echo "" >&2
  echo "커밋을 멈췄습니다. 위 파일을 고치거나 'git restore --staged <파일>'로 뺀 뒤 다시 커밋하세요." >&2
fi
exit "$fail"
