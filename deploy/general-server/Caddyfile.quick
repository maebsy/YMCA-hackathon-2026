{
	admin off
	auto_https off
}

# Only cloudflared on the same machine connects here; public visitors use HTTPS.
http://:8088 {
	bind 127.0.0.1
	basic_auth {
		{$DEMO_USER} {$DEMO_PASSWORD_HASH}
	}
	handle /healthz {
		respond "gateway ready" 200
	}
	@api path /api /api/*
	handle @api {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 900s
			}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
