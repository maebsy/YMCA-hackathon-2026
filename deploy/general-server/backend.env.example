# Server-only file: ~/.config/72hours/backend.env, mode 600. Do not commit real values.
DATABASE_URL=sqlite:////ABSOLUTE/PATH/TO/72hours/app.db
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-27b
LLM_MAX_CONCURRENCY=8
LLM_TIMEOUT_S=300
# Demo: limit Red-Blue rewrites to 1 on a single L4 (default 2). 5 findings took 647s with 2 rewrites.
LLM_RED_BLUE_MAX_REWRITES=1
# Context analysis adds one LLM call per finding (+~28s for 5 findings). Set false to use rule signals only.
LLM_ANALYZE_CONTEXT=true
# CISA KEV / FIRST EPSS lookups. Failures are cached for 5 minutes, so offline servers are not slowed down.
LLM_THREAT_INTEL=true
# 공개 시연용 해석 대기열: 동시 실행 수와 대기 상한 (GPU 상황에 맞게 조정)
LLM_PREVIEW_RUNNING=6
LLM_PREVIEW_CAPACITY=30
# Security engine scanners (bash deploy/general-server/install-scanners.sh prints these paths).
# systemd user services have a narrow PATH, so give absolute paths.
SECURITY_ENGINE_SEMGREP_BIN=/home/USER/.local/share/72hours/scanners/bin/opengrep
SECURITY_ENGINE_GITLEAKS_BIN=/home/USER/.local/share/72hours/scanners/bin/gitleaks
SECURITY_ENGINE_OSV_BIN=/home/USER/.local/share/72hours/scanners/bin/osv-scanner
# Only signed-in Supabase users may start /api/scans (needs SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY).
# Keep false until the frontend sends a real Supabase access token.
SCAN_REQUIRE_AUTH=false
# Only these GitHub owners' public repos can be scanned (comma list, case-insensitive), so the public demo
# cannot be used to mine other people's repos for vulnerabilities (#67). OWASP = demo targets (NodeGoat), the rest = team members.
# Leave empty only for local development (no restriction).
SCAN_ALLOWED_OWNERS=OWASP,maebsy,surilog,SeouliteParker,papawolf42,nick19850906-debug
# Supabase user IDs that may scan any repo (needs LLM_JOBS_ENABLED=true for sign-in).
SCAN_ADMIN_USER_IDS=
