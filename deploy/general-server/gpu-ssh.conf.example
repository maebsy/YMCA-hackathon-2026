Host 72hours-gpu
    HostName REPLACE_WITH_GPU_PRIVATE_IP
    User REPLACE_WITH_GPU_USER
    Port 22
    IdentityFile ~/.config/72hours/gpu-tunnel
    IdentitiesOnly yes
    UserKnownHostsFile ~/.config/72hours/gpu_known_hosts
    StrictHostKeyChecking yes
    BatchMode yes
    ExitOnForwardFailure yes
    ConnectTimeout 10
    ServerAliveInterval 15
    ServerAliveCountMax 3
    LocalForward 127.0.0.1:8001 127.0.0.1:8001
