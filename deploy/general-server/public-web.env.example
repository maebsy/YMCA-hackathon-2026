# Server-only file: ~/.config/72hours/public-web.env, mode 600.
# DNS name only; no scheme/path. DNS and inbound TCP 80/443 must point to this server.
PUBLIC_DOMAIN=
DEMO_USER=demo
# Generate interactively with: ~/.local/share/72hours/bin/caddy hash-password
# systemd EnvironmentFile reads $ literally; do NOT source this file in a shell.
DEMO_PASSWORD_HASH=
