{
	admin off
	auto_https off
}

# Reviewed replacement for PR #25's quick origin AFTER the authenticated API is enabled.
# Never remove all Basic protection just to make Bearer requests work.
http://:8088 {
	bind 127.0.0.1
	@jobs path_regexp jobs ^/api/scans/[1-9][0-9]*/explanations/?$
	handle @jobs {
		request_body {
			max_size 4KB
		}
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		basic_auth {
			{$DEMO_USER} {$DEMO_PASSWORD_HASH}
		}
		handle /healthz {
			respond "gateway ready" 200
		}
		@api path /api /api/*
		handle @api {
			header Cache-Control "no-store"
			reverse_proxy 127.0.0.1:8000
		}
		handle {
			reverse_proxy 127.0.0.1:3000
		}
	}
}
